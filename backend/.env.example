# Environment (development | production | test)
NODE_ENV=development

# Port configuration
PORT=3001

# MariaDB / MySQL Connection URL
# Example: mysql://root:password@localhost:3306/mjm_store
DATABASE_URL="mysql://root:@localhost:3306/mjm_store"

# JWT Authentication Secrets (min 16 chars â€” boot fails otherwise)
JWT_SECRET="<GENERATE_A_LONG_RANDOM_SECRET>"
JWT_REFRESH_SECRET="mjm_super_secret_jwt_refresh_key_2026"

# Token lifetimes (ms-style strings, e.g. 15m, 2h, 7d, 30d)
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Public base URL used for absolute media links (never localhost in prod)
PUBLIC_URL="http://localhost:3001"

# Frontend origin allowed by CORS in production
FRONTEND_URL="http://localhost:3002"

# Extra CORS origins (comma-separated, no trailing slash).
# Production example: ALLOWED_ORIGINS="https://shop.example.com,https://admin.example.com"
# - Every environment uses a strict allowlist: unlisted Origins are rejected,
#   and no wildcard is ever combined with credentials.
# - Development/test additionally allow loopback only
#   (http://localhost:3000-3002, http://127.0.0.1:3000-3002).
# - Production adds NO loopback defaults: set FRONTEND_URL/ALLOWED_ORIGINS.
ALLOWED_ORIGINS=""

# Swagger /api/docs policy: served in development/test, NOT mounted in
# production unless explicitly enabled (protected staging, etc.).
DOCS_ENABLED="false"

# Cookies: Secure=true is applied automatically when NODE_ENV=production
# (HTTPS). Keep NODE_ENV unset/development on plain-HTTP localhost so
# browsers accept the session cookies during dev and automated tests.

